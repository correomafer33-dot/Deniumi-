    <script>
        // Language Switching
        const langButtons = document.querySelectorAll('.lang-btn');
        let currentLang = localStorage.getItem('lang') || 'es';

        function setLanguage(lang) {
            currentLang = lang;
            localStorage.setItem('lang', lang);

            langButtons.forEach(btn => {
                btn.classList.remove('active');
                if (btn.dataset.lang === lang) btn.classList.add('active');
            });

            document.querySelectorAll('[data-es][data-de]').forEach(el => {
                el.textContent = el.dataset[lang] || el.textContent;
            });

            document.querySelectorAll('[data-es][data-de]:not(input):not(textarea)').forEach(el => {
                if (el.dataset[lang]) {
                    el.innerHTML = el.innerHTML.replace(
                        el.textContent,
                        el.dataset[lang]
                    );
                }
            });
        }

        langButtons.forEach(btn => {
            btn.addEventListener('click', () => setLanguage(btn.dataset.lang));
        });

        setLanguage(currentLang);

        // Morphing Shape Animation
        const morphPath = document.querySelector('.morph-path');
        const shapes = [
            'M150,60 C200,60 240,100 240,150 C240,200 200,240 150,240 C100,240 60,200 60,150 C60,100 100,60 150,60 Z',
            'M150,70 C210,80 235,110 235,150 C235,205 195,245 150,245 C95,240 60,205 60,150 C65,95 105,65 150,70 Z',
            'M140,55 C200,50 245,95 245,150 C245,210 200,250 140,250 C80,245 55,210 60,150 C55,90 85,55 140,55 Z',
            'M155,65 C215,65 240,110 235,155 C240,205 200,245 155,245 C100,240 65,205 70,150 C65,100 100,65 155,65 Z'
        ];

        let shapeIndex = 0;

        function animateMorphing() {
            shapeIndex = (shapeIndex + 1) % shapes.length;
            morphPath.setAttribute('d', shapes[shapeIndex]);
        }

        setInterval(animateMorphing, 2000);

        // Scroll Reveal
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.reveal').forEach(el => {
            observer.observe(el);
        });

        // Form Submission
        document.getElementById('contactForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            // Validate form
            const formData = new FormData(e.target);
            const data = {
                name: formData.get('name'),
                email: formData.get('email'),
                stage: formData.get('stage'),
                message: formData.get('message')
            };

            // Send to Formspree (update with your form endpoint)
            try {
                const response = await fetch('https://formspree.io/f/YOUR_FORM_ID', {
                    method: 'POST',
                    body: JSON.stringify(data),
                    headers: {
                        'Accept': 'application/json'
                    }
                });

                if (response.ok) {
                    alert('Mensaje enviado con éxito. Gracias por contactarme!');
                    e.target.reset();
                } else {
                    alert('Error al enviar. Intenta de nuevo.');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error de conexión. Intenta de nuevo más tarde.');
            }
        });

        // Manejar carga de imágenes
        const heroImage = document.getElementById('heroImage');
        const placeholder = document.getElementById('heroImagePlaceholder');
        const profileImage = document.getElementById('hero-profile-img');

        if (heroImage && placeholder) {
            heroImage.addEventListener('load', function() {
                placeholder.classList.add('hidden');
            });
            
            // Si la imagen ya está en caché, también ocultamos el placeholder
            if (heroImage.complete) {
                placeholder.classList.add('hidden');
            }
        }

        if (profileImage) {
            profileImage.addEventListener('load', function() {
                document.getElementById('profile-placeholder').style.display = 'none';
            });
            if (profileImage.complete) {
                document.getElementById('profile-placeholder').style.display = 'none';
            }
        }

        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                const href = this.getAttribute('href');
                if (href !== '#' && document.querySelector(href)) {
                    e.preventDefault();
                    document.querySelector(href).scrollIntoView({ behavior: 'smooth' });
                }
            });
        });
    </script>
